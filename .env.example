# Copy to .env and adjust if you need local overrides
# Docker Compose loads .env automatically if present at project root

POSTGRES_DB=indicadoresar
POSTGRES_USER=indicadoresar
POSTGRES_PASSWORD=indicadoresar

# Override only if you need custom host/port
# For local run without Docker: jdbc:postgresql://localhost:5432/indicadoresar
# For Docker Compose (app -> db): jdbc:postgresql://db:5432/indicadoresar
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/indicadoresar
SPRING_DATASOURCE_USERNAME=indicadoresar
SPRING_DATASOURCE_PASSWORD=indicadoresar
